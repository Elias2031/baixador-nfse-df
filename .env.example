# CN (Common Name) do certificado digital A1/A3 instalado no Windows que tem
# acesso (ou procuração) às empresas da planilha. Formato típico: "NOME DO TITULAR:CPF"
CERTIFICADO_CN=NOME DO TITULAR:00000000000

# Padrão de URL em que o Chrome deve selecionar o certificado automaticamente
# (política AutoSelectCertificateForUrls). Ajuste para o endereço de login do portal.
CERTIFICADO_URL_PATTERN=https://api.ihub.com.br/certificado/login*
